# Modo demonstração — build público de portfólio, sem acesso a dado real.
VITE_DEMO_MODE=1

# Placeholders sintaticamente válidos e inertes. `.invalid` é reservado pela
# RFC 2606 e nunca resolve. Não podem ficar vazios: o cliente do Supabase
# lança quando a variável falta, e o sintoma seria a página em branco.
VITE_SUPABASE_URL=https://demo.supabase.invalid
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_demo_0000000000000000000
VITE_SUPABASE_PROJECT_ID=demo
SUPABASE_URL=https://demo.supabase.invalid
SUPABASE_PUBLISHABLE_KEY=sb_publishable_demo_0000000000000000000
SUPABASE_SERVICE_ROLE_KEY=sb_secret_demo_0000000000000000000
